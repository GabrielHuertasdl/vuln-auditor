# =============================================================================
# VulnAuditor ASPM — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development        # development | staging | production
LOG_LEVEL=INFO
DATA_DIR=./data
FRONTEND_URL=http://localhost:5173

# ── Security (REQUIRED in production) ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_AUTH=false         # Set true in staging/production
DEMO_ORG_NAME=Demo Organization

# ── Database ───────────────────────────────────────────────────────────────────
# Development (SQLite — single-process only)
DATABASE_URL=sqlite+aiosqlite:///data/vulnaudit.db

# Production (PostgreSQL — required for multi-worker)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/vulnaudit

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI Providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ── Storage Backend ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local      # local | s3

# S3 / MinIO (required if STORAGE_BACKEND=s3)
# S3_BUCKET=vulnaudit-scans
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=          # MinIO: http://minio:9000

# ── OIDC / SSO ────────────────────────────────────────────────────────────────
# pip install "vulnerability-detector[sso]"
OIDC_REDIRECT_BASE_URL=http://localhost:8000

# Google Workspace
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# Microsoft Azure AD / Entra ID
# OIDC_AZURE_CLIENT_ID=
# OIDC_AZURE_CLIENT_SECRET=
# OIDC_AZURE_TENANT_ID=common

# Okta
# OIDC_OKTA_DOMAIN=your-org.okta.com
# OIDC_OKTA_CLIENT_ID=
# OIDC_OKTA_CLIENT_SECRET=

# ── Billing / Stripe ──────────────────────────────────────────────────────────
# pip install "vulnerability-detector[billing]"
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_...

# ── Scanner Configuration ─────────────────────────────────────────────────────
ZAP_API_URL=
NMAP_TIMEOUT=1800
NMAP_FLAGS=-sV -sC --script=vuln -T4
SCAN_TIMEOUT_SECONDS=1800
ALLOW_PRIVATE_SCANNING=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SCAN_CREATE=10/hour
RATE_LIMIT_AI=30/hour
RATE_LIMIT_REPORT_EXPORT=20/hour
RATE_LIMIT_DEFAULT=200/hour

# ── CI/CD ─────────────────────────────────────────────────────────────────────
# CI_FAIL_THRESHOLD=high

# ── Notifications ─────────────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=
# NOTIFICATION_WEBHOOK_URL=
# JIRA_API_URL=
# JIRA_API_KEY=

# ── Docker / PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_USER=auditor
POSTGRES_PASSWORD=auditor_pass
POSTGRES_DB=vulnaudit
